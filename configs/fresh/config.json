                "D101", "D100", "D203", "D213", "INP001", "D106", "D107",
                "D102", "ERA001", "TRY003", "BLE001", "PERF203", "ANN401",
                "TRY301", "FBT001", "FBT002", "S101", "DTZ005", "G201",
                "RUF012", "CY001"
              ]
            }
          }
        }
      }
    }
