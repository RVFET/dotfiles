  "keybindings": [
    {
      "key": "f",
      "modifiers": ["alt", "shift"],
      "action": "format_buffer"
    },
    {
      "key": "Tab",
      "modifiers": ["ctrl"],
      "action": "next_window"
    },
    {
      "key": "Tab",
      "modifiers": ["ctrl", "shift"],
      "action": "prev_window"
    },
    {
      "key": "n",
      "modifiers": ["alt", "shift"],
      "action": "jump_to_next_error",
      "when": "normal"
    },
    {
      "key": "e",
      "modifiers": ["ctrl"],
      "action": "shell_command",
      "when": "normal"
    },
    {
      "key": "Enter",
      "modifiers": ["alt"],
      "action": "find_next",
      "when": "normal"
    },
    {
      "key": "Enter",
      "modifiers": ["alt", "shift"],
      "action": "find_previous",
      "when": "normal"
    },
    {
      "key": "Right",
      "modifiers": ["alt"],
      "action": "toggle_file_explorer",
      "when": "file_explorer"
    },
    {
      "key": "Right",
      "modifiers": ["alt"],
      "action": "toggle_file_explorer",
      "when": "normal"
    },
    {
      "key": "Left",
      "modifiers": ["alt"],
      "action": "orchestrator_dock_toggle",
      "when": "global"
    },
    {
      "key": "Delete",
      "modifiers": ["alt"],
      "action": "orchestrator_kill"
    },
    {
      "key": " ",
      "modifiers": ["ctrl", "shift"],
      "action": "select_line",
      "when": "normal"
    },
    {
      "key": "*",
      "modifiers": ["alt"],
      "action": "orchestrator_open",
      "when": ""
    }
  ]
