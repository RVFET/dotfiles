# === THEME ===
theme = Arthur

# === SYSTEM ===
shell-integration = none
grapheme-width-method = unicode
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell
bell-features = audio, attention, border
window-inherit-working-directory = true
focus-follows-mouse = true
quit-after-last-window-closed = true
undo-timeout = 1y

# === FONT ===
font-family = "JetBrainsMono"
font-size = 12
font-style = "Medium"
font-style-bold = "Bold"
font-style-italic = "Italic"

# === WINDOW ===
window-decoration = false
background-opacity = 0.94
background-blur = true
mouse-scroll-multiplier = 0.5

# === BACKGROUND ===
# background-image = ~/Downloads/grid_tile.png
# background-image-fit = none
# background-image-repeat = true
# background-image-position = top-left
# background-image-opacity = 0.01

# Padding
window-padding-x = 15
window-padding-y = 15
window-padding-balance = true

# === SCROLLING ===
# mouse-scroll-multiplier = 5

# === CURSOR ===
cursor-style = bar
adjust-cursor-thickness = 3
cursor-style-blink = true

# === KEYBINDINGS ===
# keybind = ctrl+shift+f=search
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+l=text:clear\n
keybind = ctrl+shift+n=new_window
keybind = ctrl+enter=toggle_fullscreen
keybind = ctrl+up=scroll_page_up
keybind = ctrl+down=scroll_page_down

keybind = ctrl+shift+left=unbind
keybind = ctrl+shift+right=unbind
keybind = shift+end=unbind
keybind = shift+home=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = alt+left=unbind
keybind = alt+right=unbind
