#!/usr/bin/env python3

from __future__ import annotations

import abc
import inspect
import os
import re
import socket
import subprocess
import sys
from base64 import b64decode, b64encode
from pathlib import Path
from secrets import token_hex
from typing import Any, Callable, Optional

import requests
import typer
from pyperclip import copy, paste
from rich import print as rich_print
from rich.console import Console
from rich.panel import Panel

err_console = Console(stderr=True)


def _copy_clipboard(data: str) -> None:
    try:
        copy(data)
        err_console.print("[green]Copied to clipboard[/green]")
    except Exception as e:
        err_console.print(f"[red]Clipboard error: {e}[/red]")


def _get_clipboard_text() -> str:
    """Retrieve text across Wayland/Hyprland (wl-paste), macOS (pbpaste), and X11/pyperclip."""
    # 1. Wayland / Hyprland check
    if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        try:
            res = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, check=True)
            if res.stdout:
                return res.stdout
        except (FileNotFoundError, subprocess.SubprocessError):
            pass

    # 2. macOS check
    if sys.platform == "darwin":
        try:
            res = subprocess.run(["pbpaste"], capture_output=True, text=True, check=True)
            if res.stdout:
                return res.stdout
        except (FileNotFoundError, subprocess.SubprocessError):
            pass

    # 3. pyperclip fallback
    try:
        val = paste()
        if val:
            return val
    except Exception:
        pass

    # 4. X11 fallback (xclip / xsel)
    for cmd in [["xclip", "-selection", "clipboard", "-o"], ["xsel", "--clipboard", "--output"]]:
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, check=True)
            if res.stdout:
                return res.stdout
        except (FileNotFoundError, subprocess.SubprocessError):
            continue

    return ""


def _confirm_action(prompt_msg: str) -> bool:
    """Prompt user for confirmation (y/N) defaulting to No. Reads /dev/tty if stdin was piped."""
    err_console.print(f"[bold yellow]{prompt_msg} [y/N]: [/bold yellow]", end="")
    try:
        if os.path.exists("/dev/tty") and not sys.stdin.isatty():
            with open("/dev/tty", "r") as tty:
                reply = tty.readline().strip().lower()
        else:
            reply = input().strip().lower()
    except (EOFError, OSError):
        err_console.print("\n[red]Cannot prompt for confirmation. Pass -y/--yes for non-interactive use.[/red]")
        return False

    return reply in ("y", "yes")


def _resolve_text_input(text: Optional[str]) -> Optional[str]:
    """Read from positional argument if supplied, otherwise ingest stdin."""
    if text is not None and text != "-":
        return text
    if not sys.stdin.isatty():
        return sys.stdin.read()
    err_console.print("[red]Error: Missing input text and stdin is empty.[/red]")
    return None


class Plugin(abc.ABC):
    """Base plugin class. Subclasses declare CLI metadata and a typed execute() method."""

    name: str
    description: str
    aliases: list[str] = []

    @classmethod
    def register(cls, app: typer.Typer) -> None:
        """Register command and its aliases directly to the Typer app."""
        app.command(
            name=cls.name,
            help=cls.description,
            no_args_is_help=cls.no_args_is_help(),
        )(cls.execute)

        for alias in cls.aliases:
            app.command(
                name=alias,
                help=cls.description,
                hidden=True,
            )(cls.execute)

    @classmethod
    def no_args_is_help(cls) -> bool:
        return False

    @staticmethod
    @abc.abstractmethod
    def execute(*args: Any, **kwargs: Any) -> Any:
        """Executed by Typer. Arguments and flags are declared as typed parameters."""


# ================================================================= #
#                     Plugin Implementations                        #
# ================================================================= #


class RandomStringPlugin(Plugin):
    name = "random"
    description = "Generate a random hexadecimal string"
    aliases = ["rand", "rnd", "r"]

    @staticmethod
    def execute(
        length: int = typer.Argument(32, help="Length of the random string to generate"),
        copy_to_clipboard: bool = typer.Option(False, "--copy", "-c", help="Copy the output to clipboard"),
    ) -> str:
        result = token_hex((length + 1) // 2)[:length]
        rich_print(result)
        if copy_to_clipboard:
            _copy_clipboard(result)
        return result


class Base64EncodePlugin(Plugin):
    name = "encode"
    description = "Encode a string to base64"
    aliases = ["enc", "e"]

    @staticmethod
    def execute(
        text: Optional[str] = typer.Argument(None, help="Text to encode (reads stdin if omitted or '-')"),
        copy_to_clipboard: bool = typer.Option(False, "--copy", "-c", help="Copy the output to clipboard"),
    ) -> Optional[str]:
        payload = _resolve_text_input(text)
        if payload is None:
            raise typer.Exit(code=1)

        result = b64encode(payload.encode()).decode()
        rich_print(result)
        if copy_to_clipboard:
            _copy_clipboard(result)
        return result


class Base64DecodePlugin(Plugin):
    name = "decode"
    description = "Decode a base64 string"
    aliases = ["dec", "d"]

    @staticmethod
    def execute(
        text: Optional[str] = typer.Argument(None, help="Base64 text to decode (reads stdin if omitted or '-')"),
        copy_to_clipboard: bool = typer.Option(False, "--copy", "-c", help="Copy the output to clipboard"),
    ) -> Optional[str]:
        payload = _resolve_text_input(text)
        if payload is None:
            raise typer.Exit(code=1)

        try:
            result = b64decode(payload.strip().encode()).decode()
            rich_print(result)
            if copy_to_clipboard:
                _copy_clipboard(result)
            return result
        except Exception as e:
            err_console.print(f"[red]Failed to decode: {e}[/red]")
            raise typer.Exit(code=1)


class AIFilesPlugin(Plugin):
    name = "for-ai"
    description = "Read files recursively and format for AI consumption"
    aliases = ["ai"]

    @staticmethod
    def execute(
        directory: Path = typer.Option(Path("."), "--dir", "-d", help="Starting directory for file traversal"),
        depth: int = typer.Option(10, "--depth", "-L", help="Maximum depth for file traversal"),
        ignore: Optional[str] = typer.Option(None, "--ignore", "-i", help="Regex pattern to ignore files"),
        copy_to_clipboard: bool = typer.Option(False, "--copy", "-c", help="Copy the output to clipboard"),
    ) -> str:
        result = AIFilesPlugin._read_files_for_ai(str(directory), depth, ignore)
        rich_print(result)
        if copy_to_clipboard:
            _copy_clipboard(result)
        return result

    @staticmethod
    def _read_files_for_ai(
        start_dir: str = ".",
        max_depth: int = 10,
        ignore_pattern: str | None = None,
    ) -> str:
        output = []
        start_path = Path(start_dir).resolve()
        for root, _, files in os.walk(start_path):
            current_path = Path(root)
            depth = len(current_path.relative_to(start_path).parts)
            if depth > max_depth:
                continue
            for file in files:
                file_path = current_path / file
                rel_path = file_path.relative_to(start_path)
                if (ignore_pattern and re.search(ignore_pattern, str(rel_path))) or file_path.name.startswith("."):
                    continue
                try:
                    with file_path.open("rb") as f:
                        content = f.read(1024)
                    if b"\x00" in content:
                        continue

                    with file_path.open(encoding="utf-8", errors="replace") as f:
                        content_str = f.read()
                    output.append(f"\n./{rel_path}:\n```\n{content_str}\n```\n")
                except Exception as e:
                    err_console.print(f"[red]Failed to read {file_path}: {e}[/red]")
                    continue
        return "".join(output)


class FileUploaderPlugin(Plugin):
    AVAILABLE_SERVICES = {
        "bashupload": {
            "domain": "bashupload.com",
            "size": "50GB",
            "duration": "3 days",
        },
        "litterbox": {
            "domain": "litterbox.catbox.moe",
            "size": "1GB",
            "duration": "3 days",
        },
        "0x0": {
            "domain": "0x0.st",
            "size": "512MB",
            "duration": "30 days",
        },
        "tempsh": {
            "domain": "temp.sh",
            "size": "4GB",
            "duration": "3 days",
        },
        "tmpfiles": {
            "domain": "tmpfiles.org",
            "size": "100MB",
            "duration": "60 minutes",
        },
    }
    DEFAULT_SERVICE = "bashupload"

    name = "upload"
    description = "Upload a file to one of the supported services (auto-fallback on failure)"
    aliases = ["up", "u"]

    @staticmethod
    def _upload_bashupload(file_path: Path) -> str:
        try:
            with file_path.open("rb") as f:
                response = requests.post(
                    "https://bashupload.com/",
                    data={"file": f.read()},
                    headers={"Content-Type": "application/octet-stream"},
                    timeout=(10, 300),
                )
            if response.status_code == 200 and "wget " in response.text:
                return response.text.split("wget ")[1].split("\n")[0].strip()
            err_console.print(f"[dim]bashupload HTTP {response.status_code}[/dim]")
            return ""
        except Exception as e:
            err_console.print(f"[dim]bashupload error: {e}[/dim]")
            return ""

    @staticmethod
    def _upload_litterbox(file_path: Path) -> str:
        try:
            with file_path.open("rb") as f:
                response = requests.post(
                    "https://litterbox.catbox.moe/resources/internals/api.php",
                    data={"reqtype": "fileupload", "time": "72h"},
                    files={"fileToUpload": (file_path.name, f)},
                    timeout=(10, 300),
                )
            if response.status_code == 200 and response.text.strip().startswith("http"):
                return response.text.strip()
            err_console.print(f"[dim]litterbox HTTP {response.status_code}[/dim]")
            return ""
        except Exception as e:
            err_console.print(f"[dim]litterbox error: {e}[/dim]")
            return ""

    @staticmethod
    def _upload_0x0(file_path: Path) -> str:
        try:
            with file_path.open("rb") as f:
                response = requests.post(
                    "https://0x0.st",
                    files={"file": (file_path.name, f)},
                    timeout=(10, 300),
                )
            if response.status_code == 200 and response.text.strip().startswith("http"):
                return response.text.strip()
            err_console.print(f"[dim]0x0.st HTTP {response.status_code}[/dim]")
            return ""
        except Exception as e:
            err_console.print(f"[dim]0x0.st error: {e}[/dim]")
            return ""

    @staticmethod
    def _upload_tempsh(file_path: Path) -> str:
        try:
            with file_path.open("rb") as f:
                response = requests.post(
                    "https://temp.sh/upload",
                    files={"file": (file_path.name, f, "application/octet-stream")},
                    timeout=(10, 300),
                )
            if response.status_code == 200 and response.text.strip().startswith("http"):
                return response.text.strip()
            err_console.print(f"[dim]temp.sh HTTP {response.status_code}[/dim]")
            return ""
        except Exception as e:
            err_console.print(f"[dim]temp.sh error: {e}[/dim]")
            return ""

    @staticmethod
    def _upload_tmpfiles(file_path: Path) -> str:
        try:
            with file_path.open("rb") as f:
                response = requests.post(
                    "https://tmpfiles.org/api/v1/upload",
                    files={"file": (file_path.name, f, "application/octet-stream")},
                    timeout=(10, 300),
                )
            if response.status_code == 200:
                data = response.json()
                if data.get("status") == "success" and "data" in data and "url" in data["data"]:
                    return data["data"]["url"]
            err_console.print(f"[dim]tmpfiles HTTP {response.status_code}[/dim]")
            return ""
        except Exception as e:
            err_console.print(f"[dim]tmpfiles error: {e}[/dim]")
            return ""

    @classmethod
    def _resolve_service(cls, service_input: str) -> str:
        service_keys = list(cls.AVAILABLE_SERVICES.keys())

        if service_input.isdigit():
            idx = int(service_input)
            if 1 <= idx <= len(service_keys):
                return service_keys[idx - 1]
            if idx == 0:
                return service_keys[0]
            err_console.print(
                f"[yellow]Index {service_input} out of bounds (1-{len(service_keys)}). Defaulting to {cls.DEFAULT_SERVICE}.[/yellow]"
            )
            return cls.DEFAULT_SERVICE

        cleaned = service_input.strip().lower()
        for key in service_keys:
            if cleaned == key.lower():
                return key

        err_console.print(
            f"[yellow]Unknown service '{service_input}'. Defaulting to {cls.DEFAULT_SERVICE}.[/yellow]"
        )
        return cls.DEFAULT_SERVICE

    @classmethod
    def _help(cls) -> None:
        err_console.print("[bold]Available upload services:[/bold]")
        for idx, (service, meta) in enumerate(cls.AVAILABLE_SERVICES.items(), start=1):
            err_console.print(
                f"[bold cyan][{idx}][/bold cyan] [green]{service:<10}[/green] [dim]({meta['domain']})[/dim]\n"
                f"    Limit: {meta['size']} | Retention: {meta['duration']}"
            )

    @staticmethod
    def execute(
        file: Optional[Path] = typer.Argument(None, help="Path to the file to upload"),
        service: str = typer.Option(
            DEFAULT_SERVICE,
            "--service",
            "-s",
            help="Upload service name or 1-based index",
        ),
        list_services: bool = typer.Option(
            False,
            "--list-services",
            "-l",
            help="List available services and exit",
        ),
        copy_to_clipboard: bool = typer.Option(
            False,
            "--copy",
            "-c",
            help="Copy resulting URL to clipboard",
        ),
    ) -> Optional[str]:
        if list_services:
            FileUploaderPlugin._help()
            return None

        if not file:
            err_console.print("[red]Error: No file specified for upload[/red]")
            FileUploaderPlugin._help()
            raise typer.Exit(code=1)

        if not file.exists():
            err_console.print(f"[red]Error: File '{file}' not found[/red]")
            raise typer.Exit(code=1)

        upload_methods: dict[str, Callable[[Path], str]] = {
            "bashupload": FileUploaderPlugin._upload_bashupload,
            "litterbox": FileUploaderPlugin._upload_litterbox,
            "0x0": FileUploaderPlugin._upload_0x0,
            "tempsh": FileUploaderPlugin._upload_tempsh,
            "tmpfiles": FileUploaderPlugin._upload_tmpfiles,
        }

        selected_service = FileUploaderPlugin._resolve_service(service)
        service_keys = list(FileUploaderPlugin.AVAILABLE_SERVICES.keys())
        start_idx = service_keys.index(selected_service)
        rotation = service_keys[start_idx:] + service_keys[:start_idx]

        for srv in rotation:
            err_console.print(f"[bold]Uploading {file.name} to {srv}...[/bold]")
            url = upload_methods[srv](file)
            if url:
                rich_print(f"[green]Successfully uploaded to: {url}[/green]")
                if copy_to_clipboard:
                    _copy_clipboard(url)
                return url
            err_console.print(f"[yellow]Host '{srv}' failed or unreachable. Falling back to next...[/yellow]")

        err_console.print("[red]Error: All upload services failed.[/red]")
        raise typer.Exit(code=1)


class PastePlugin(Plugin):
    AVAILABLE_SERVICES = {
        "termbin": {
            "domain": "termbin.com:9999",
            "size": "5MB",
            "duration": "30 days",
        },
        "ixio": {
            "domain": "ix.io",
            "size": "2.8MB",
            "duration": "Indefinite",
        },
        "dpaste": {
            "domain": "dpaste.com",
            "size": "1MB",
            "duration": "14 days",
        },
        "0x0": {
            "domain": "0x0.st",
            "size": "512MB",
            "duration": "30 days",
        },
    }
    DEFAULT_SERVICE = "termbin"

    name = "paste"
    description = "Paste text or clipboard to a pastebin service (auto-fallback on failure)"
    aliases = ["pst", "p"]

    @staticmethod
    def _paste_termbin(payload: str) -> str:
        try:
            with socket.create_connection(("termbin.com", 9999), timeout=10) as s:
                s.sendall(payload.encode("utf-8"))
                s.shutdown(socket.SHUT_WR)
                resp = s.recv(1024).decode("utf-8", errors="replace")
                url = resp.strip("\x00\r\n ")
                if url.startswith("http"):
                    return url
            err_console.print("[dim]termbin returned non-HTTP response[/dim]")
            return ""
        except Exception as e:
            err_console.print(f"[dim]termbin error: {e}[/dim]")
            return ""

    @staticmethod
    def _paste_ixio(payload: str) -> str:
        try:
            resp = requests.post("http://ix.io", data={"f:1": payload}, timeout=(10, 30))
            if resp.status_code == 200 and resp.text.strip().startswith("http"):
                return resp.text.strip()
            err_console.print(f"[dim]ix.io HTTP {resp.status_code}[/dim]")
            return ""
        except Exception as e:
            err_console.print(f"[dim]ix.io error: {e}[/dim]")
            return ""

    @staticmethod
    def _paste_dpaste(payload: str) -> str:
        try:
            resp = requests.post(
                "https://dpaste.com/api/",
                data={"content": payload, "expiry_days": 14},
                timeout=(10, 30),
            )
            if resp.status_code in (200, 201):
                url = resp.text.strip()
                if not url.startswith("http") and "Location" in resp.headers:
                    url = resp.headers["Location"]
                if url.startswith("http"):
                    return url
            err_console.print(f"[dim]dpaste HTTP {resp.status_code}[/dim]")
            return ""
        except Exception as e:
            err_console.print(f"[dim]dpaste error: {e}[/dim]")
            return ""

    @staticmethod
    def _paste_0x0(payload: str) -> str:
        try:
            resp = requests.post(
                "https://0x0.st",
                files={"file": ("paste.txt", payload.encode("utf-8"))},
                timeout=(10, 30),
            )
            if resp.status_code == 200 and resp.text.strip().startswith("http"):
                return resp.text.strip()
            err_console.print(f"[dim]0x0.st HTTP {resp.status_code}[/dim]")
            return ""
        except Exception as e:
            err_console.print(f"[dim]0x0.st error: {e}[/dim]")
            return ""

    @classmethod
    def _resolve_service(cls, service_input: str) -> str:
        service_keys = list(cls.AVAILABLE_SERVICES.keys())

        if service_input.isdigit():
            idx = int(service_input)
            if 1 <= idx <= len(service_keys):
                return service_keys[idx - 1]
            if idx == 0:
                return service_keys[0]
            err_console.print(
                f"[yellow]Index {service_input} out of bounds (1-{len(service_keys)}). Defaulting to {cls.DEFAULT_SERVICE}.[/yellow]"
            )
            return cls.DEFAULT_SERVICE

        cleaned = service_input.strip().lower()
        for key in service_keys:
            if cleaned == key.lower():
                return key

        err_console.print(
            f"[yellow]Unknown service '{service_input}'. Defaulting to {cls.DEFAULT_SERVICE}.[/yellow]"
        )
        return cls.DEFAULT_SERVICE

    @classmethod
    def _help(cls) -> None:
        err_console.print("[bold]Available paste services:[/bold]")
        for idx, (service, meta) in enumerate(cls.AVAILABLE_SERVICES.items(), start=1):
            err_console.print(
                f"[bold cyan][{idx}][/bold cyan] [green]{service:<10}[/green] [dim]({meta['domain']})[/dim]\n"
                f"    Limit: {meta['size']} | Retention: {meta['duration']}"
            )

    @staticmethod
    def execute(
        text: Optional[str] = typer.Argument(
            None,
            help="Text to paste (reads clipboard or stdin if omitted)",
        ),
        file: Optional[Path] = typer.Option(
            None,
            "--file",
            "-f",
            help="Read content from file instead of clipboard/stdin",
        ),
        service: str = typer.Option(
            DEFAULT_SERVICE,
            "--service",
            "-s",
            help="Paste service name or 1-based index",
        ),
        list_services: bool = typer.Option(
            False,
            "--list-services",
            "-l",
            help="List available paste services and exit",
        ),
        yes: bool = typer.Option(
            False,
            "--yes",
            "-y",
            help="Skip confirmation prompt",
        ),
        copy_to_clipboard: bool = typer.Option(
            False,
            "--copy",
            "-c",
            help="Copy resulting URL to clipboard",
        ),
    ) -> Optional[str]:
        if list_services:
            PastePlugin._help()
            return None

        # Resolve payload priority: explicit file -> explicit arg -> stdin stream -> clipboard
        if file:
            if not file.exists():
                err_console.print(f"[red]Error: File '{file}' not found[/red]")
                raise typer.Exit(code=1)
            try:
                payload = file.read_text(encoding="utf-8", errors="replace")
            except Exception as e:
                err_console.print(f"[red]Error reading file: {e}[/red]")
                raise typer.Exit(code=1)
        elif text is not None and text != "-":
            payload = text
        elif not sys.stdin.isatty():
            payload = sys.stdin.read()
        else:
            err_console.print("[dim]Reading content from clipboard...[/dim]")
            payload = _get_clipboard_text()
            if not payload:
                err_console.print("[red]Error: Clipboard is empty or inaccessible, and no input provided.[/red]")
                raise typer.Exit(code=1)

        if not payload.strip():
            err_console.print("[red]Error: Content to paste is empty.[/red]")
            raise typer.Exit(code=1)

        # Preview up to first 1000 characters
        preview_text = payload[:1000]
        if len(payload) > 1000:
            preview_text += f"\n\n[dim yellow]... [truncated: {len(payload)} total characters][/dim yellow]"

        err_console.print(Panel(preview_text, title="[bold yellow]Paste Preview[/bold yellow]", border_style="cyan"))

        if not yes:
            if not _confirm_action("Proceed to paste?"):
                err_console.print("[yellow]Paste cancelled.[/yellow]")
                raise typer.Exit(code=0)

        paste_methods: dict[str, Callable[[str], str]] = {
            "termbin": PastePlugin._paste_termbin,
            "ixio": PastePlugin._paste_ixio,
            "dpaste": PastePlugin._paste_dpaste,
            "0x0": PastePlugin._paste_0x0,
        }

        selected_service = PastePlugin._resolve_service(service)
        service_keys = list(PastePlugin.AVAILABLE_SERVICES.keys())
        start_idx = service_keys.index(selected_service)
        rotation = service_keys[start_idx:] + service_keys[:start_idx]

        for srv in rotation:
            err_console.print(f"[bold]Pasting to {srv}...[/bold]")
            url = paste_methods[srv](payload)
            if url:
                rich_print(f"[green]Successfully pasted to: {url}[/green]")
                if copy_to_clipboard:
                    _copy_clipboard(url)
                return url
            err_console.print(f"[yellow]Host '{srv}' failed or unreachable. Falling back to next...[/yellow]")

        err_console.print("[red]Error: All paste services failed.[/red]")
        raise typer.Exit(code=1)


# ================================================================= #
#                     Plugin Registry and CLI                       #
# ================================================================= #


class PluginRegistry:
    """Registry that dynamically discovers Plugin subclasses."""

    @staticmethod
    def get_all_plugins() -> list[type[Plugin]]:
        plugin_classes = []
        for name, obj in globals().items():
            if inspect.isclass(obj) and issubclass(obj, Plugin) and obj != Plugin and name.endswith("Plugin"):
                plugin_classes.append(obj)
        return plugin_classes


class UtilCLI:
    """CLI orchestrator powered by Typer."""

    def __init__(self) -> None:
        self.app = typer.Typer(
            name="util",
            help="Multi-purpose operational utility",
            no_args_is_help=True,
            add_completion=False,
            rich_markup_mode="rich",
        )

    def register_plugin(self, plugin_class: type[Plugin]) -> None:
        plugin_class.register(self.app)

    def register_all_plugins(self) -> None:
        for plugin_class in PluginRegistry.get_all_plugins():
            self.register_plugin(plugin_class)

    def run(self) -> Any:
        return self.app()


def main() -> Any:
    cli = UtilCLI()
    cli.register_all_plugins()
    return cli.run()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        err_console.print("\n[red]Cancelled[/red]")
        sys.exit(130)
